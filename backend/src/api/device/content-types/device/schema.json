{
  "kind": "collectionType",
  "collectionName": "devices",
  "info": {
    "singularName": "device",
    "pluralName": "devices",
    "displayName": "Device",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "product": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product.product"
    },
    "slug": {
      "type": "uid",
      "targetField": "PageTitle",
      "required": true
    },
    "Description": {
      "type": "text",
      "required": true
    },
    "FAQ": {
      "type": "component",
      "repeatable": false,
      "component": "home-sections.faq",
      "required": true
    },
    "InfoText": {
      "type": "component",
      "repeatable": false,
      "component": "home-sections.info-text",
      "required": true
    },
    "Icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "hardware": {
      "displayName": "Hardware",
      "type": "component",
      "repeatable": false,
      "component": "device.hardware",
      "required": true
    },
    "Software": {
      "type": "component",
      "repeatable": false,
      "component": "device.hardware"
    },
    "PageTitle": {
      "type": "string",
      "required": true
    },
    "SEO": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true
    }
  }
}
