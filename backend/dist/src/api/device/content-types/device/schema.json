{
    "kind": "collectionType",
    "collectionName": "devices",
    "info": {
        "singularName": "device",
        "pluralName": "devices",
        "displayName": "Device",
        "description": ""
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "Title": {
            "type": "string",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "product": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::product.product"
        },
        "slug": {
            "type": "uid",
            "targetField": "PageTitle",
            "required": true
        },
        "Description": {
            "type": "text",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "FAQ": {
            "type": "component",
            "repeatable": false,
            "component": "home-sections.faq",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "InfoText": {
            "type": "component",
            "repeatable": false,
            "component": "home-sections.info-text",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "Icon": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images",
                "files"
            ],
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "hardware": {
            "displayName": "Hardware",
            "type": "component",
            "repeatable": false,
            "component": "device.hardware",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "Software": {
            "type": "component",
            "repeatable": false,
            "component": "device.hardware",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "PageTitle": {
            "type": "string",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "SEO": {
            "type": "component",
            "repeatable": false,
            "component": "shared.seo",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "category": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::category.category",
            "inversedBy": "devices"
        }
    }
}
